472513423061, "w": 0.36391548156738285, "x": 0.4973367508135019, "h": 0.030561759471893324, "text": "map the strategy of the team, did some scouting, lectured"}, {"conf": 1, "y": 0.7640032461120115, "w": 0.366286595662435, "x": 0.49520406861338934, "h": 0.032853384017944354, "text": "at black-board drills and took charge of practice in the"}, {"conf": 1, "y": 0.7800019686356788, "w": 0.1510723495483398, "x": 0.7103395913690099, "h": 0.02050841331481934, "text": "absence of Potsy Clark."}, {"conf": 1, "y": 0.7948560261004516, "w": 0.35496251424153646, "x": 0.49294131660769724, "h": 0.034287724494934, "text": "All of the old Lion players respect Dutch for his ability,"}, {"conf": 0.5, "y": 0.8097865863184004, "w": 0.3644239552815755, "x": 0.4968295603124144, "h": 0.03465249300003048, "text": "as well as for his personal qualities. The new players,"}, {"conf": 1, "y": 0.8246998916688439, "w": 0.36438743591308587, "x": 0.49700160313459196, "h": 0.033876911401748644, "text": "of whom there are many, will be inspired by his reputation"}, {"conf": 1, "y": 0.8386775183376222, "w": 0.3623932647705078, "x": 0.49713728787456735, "h": 0.03277363777160647, "text": "until they see for themselves why he led the National"}, {"conf": 1, "y": 0.8511615414530456, "w": 0.362611083984375, "x": 0.4972135936214839, "h": 0.03695978045463566, "text": "League in scoring, why he was All-League quarterback"}, {"conf": 1, "y": 0.8645423724509376, "w": 0.3628571319580077, "x": 0.4968165880499105, "h": 0.03900997281074514, "text": "year after year, why he is rated the greatest back of all"}, {"conf": 1, "y": 0.879399749646459, "w": 0.034307559331258175, "x": 0.8258432862132922, "h": 0.012767126560211173, "text": "time."}, {"conf": 1, "y": 0.8900119358966307, "w": 0.3499786376953125, "x": 0.4945733832153862, "h": 0.04249696731567387, "text": "Coach Earl Dutch Clark has entrusted important jobs"}, {"conf": 1, "y": 0.6264534631570018, "w": 0.3895348866780598, "x": 0.07170542974721025, "h": 0.015988422632217336, "text": "to two of his team mates of the past three seasons. The"}, {"conf": 1, "y": 0.6409883511956058, "w": 0.3294573465983073, "x": 0.13178295339658283, "h": 0.015988414287567254, "text": "jobs of assistant coach and captain of the team."}, {"conf": 1, "y": 0.6598836970633449, "w": 0.37596898396809897, "x": 0.06976744976013653, "h": 0.020348885059356725, "text": "Dutch named Jack Johnson, great left tackle for the"}, {"conf": 1, "y": 0.6757104982324573, "w": 0.3902336883544922, "x": 0.07129316639516636, "h": 0.021985365152358938, "text": "past three seasons, to be his assistant. That the choice of"}, {"conf": 1, "y": 0.6918824767156937, "w": 0.38809112548828123, "x": 0.07335163363535685, "h": 0.02043397665023805, "text": "Johnson was a popular one with the remaining players"}, {"conf": 1, "y": 0.7061244373765883, "w": 0.39208066304524736, "x": 0.0712868670463834, "h": 0.023770086765289244, "text": "on the squad, is best evidenced by the 'hustle' and spirit"}, {"conf": 1, "y": 0.7208110213677053, "w": 0.39411534627278644, "x": 0.07317407690673888, "h": 0.023334105014801043, "text": "the players have put into their work since the squad"}, {"conf": 1, "y": 0.7399974783759209, "w": 0.3201457977294922, "x": 0.14322690468044613, "h": 0.017632322311401438, "text": "assembled at Cranbrook School in August."}, {"conf": 0.5, "y": 0.7354651128910712, "w": 0.060077521006266274, "x": 0.07170542567903741, "h": 0.017441867589950588, "text": "Especially"}, {"conf": 0.5, "y": 0.7513420510815968, "w": 0.3881504313151042, "x": 0.0732985314848916, "h": 0.02285099864006035, "text": "is this true of the linemen, who are under Johnson's"}, {"conf": 1, "y": 0.7686844213445734, "w": 0.1280080413818359, "x": 0.3332828009188889, "h": 0.017863715291023263, "text": "direct supervision."}, {"conf": 1, "y": 0.790697650044215, "w": 0.37015502929687505, "x": 0.07558139545330675, "h": 0.01889539659023287, "text": "Johnson appears on the way to becoming a fine line"}, {"conf": 0.5, "y": 0.8021505999089182, "w": 0.3324317423502604, "x": 0.07489315934528454, "h": 0.024806416034698575, "text": "Big Jack is a graduate of Utah University and"}, {"conf": 1, "y": 0.8183849966293495, "w": 0.1837117513020834, "x": 0.278223954726453, "h": 0.02060377359390264, "text": "joined the Lions in 1934."}, {"conf": 1, "y": 0.8386627658978839, "w": 0.37209302266438804, "x": 0.07364340649726349, "h": 0.023255861997604432, "text": "The boss on the playing field is Captain Ernie Caddel."}, {"conf": 1, "y": 0.8531976481457288, "w": 0.39147285461425774, "x": 0.07558140704364619, "h": 0.02034888982772831, "text": "The flectest back in the National Football League is"}, {"conf": 1, "y": 0.8661284792833442, "w": 0.38635350545247393, "x": 0.07698454745589382, "h": 0.025501701831817658, "text": "respected and admired by every tnember on the squad."}, {"conf": 1, "y": 0.8808139289841319, "w": 0.3875968933105468, "x": 0.07558139753077309, "h": 0.021802375316619882, "text": "Caddel is more than just a captain. He is now, and has"}, {"conf": 0.5, "y": 0.893895323155659, "w": 0.3895348612467448, "x": 0.07558140035207998, "h": 0.01889539897441861, "text": "been for the past six weeks a counselor for the new boys"}, {"conf": 1, "y": 0.9110201683677943, "w": 0.102869332631429, "x": 0.3603870375253478, "h": 0.015168966054916355, "text": "on the squad."}, {"conf": 1, "y": 0.9069767263668327, "w": 0.2829457346598307, "x": 0.07558139977279775, "h": 0.020348875522613552, "text": "Ernie is their leader both on and off the"}]}, {"image": "E94AAOSwJ-FiAxjt.jpg", "words": 16, "px": [1200, 1600], "orientation": "down", "mean_conf": 0.811, "lineup_heading": false, "position_words": 0, "bio_words": 0, "lines": [{"conf": 1, "y": 0.048412601347251005, "w": 0.3348601531982422, "x": 0.3365098499490377, "h": 0.02860667347908019, "text": "DETROIT LIONS 1937"}, {"conf": 1, "y": 0.19912790223220755, "w": 0.05620155970255536, "x": 0.7015503831948816, "h": 0.05523256778717034, "text": "2"}, {"conf": 1, "y