ed"}, {"conf": 1, "y": 0.31170863001640503, "w": 0.025409339666366576, "x": 0.2466126533176166, "h": 0.5413024902343749, "text": "Lions in 1934. Is a member of Pi Kappa Alpha fraternity. Is a rancher in off season."}, {"conf": 1, "y": 0.307800128889373, "w": 0.022755036354064923, "x": 0.1537167957192066, "h": 0.5413432312011718, "text": "GEORGE WASHINGTON CHRISTENSEN: Born in Pendleton, Oregon. Grad-"}, {"conf": 1, "y": 0.3058645186856682, "w": 0.023279645442962627, "x": 0.13839900249558743, "h": 0.541318868001302, "text": "uated from University of Oregon. Has made two trips to Hawaii. Last winter spent"}, {"conf": 0.5, "y": 0.3077733438389567, "w": 0.02442028403282165, "x": 0.1238973380602717, "h": 0.5413156127929688, "text": "four months in Tahiti. Is a member of Phi Gamma fraternity. Employed in off season"}, {"conf": 1, "y": 0.3077857245024874, "w": 0.024478336572647114, "x": 0.11002899600617627, "h": 0.5394326273600261, "text": "by Chrysler Corporation in personnel department. Works under personnel director"}, {"conf": 1, "y": 0.7151162817782302, "w": 0.013081403970718386, "x": 0.09883720490659817, "h": 0.12984495798746742, "text": "Charles T. Winegar."}]}]}